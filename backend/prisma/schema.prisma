generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  BOOLEAN
  INPUT
  CHECKBOX
}


model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  quizzes      Quiz[]
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  questions Question[]

  @@index([authorId])
}

model Question {
  id             String       @id @default(uuid())
  quizId         String
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type           QuestionType
  text           String
  position       Int
  correctBoolean Boolean?
  correctText    String?
  options        Option[]

  @@index([quizId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
  position   Int

  @@index([questionId])
}